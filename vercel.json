{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "dist",
  "functions": {
    "api/live-lage.js": {
      "maxDuration": 10,
      "supportsCancellation": true
    },
    "api/places.js": {
      "maxDuration": 20,
      "supportsCancellation": true
    },
    "api/route.js": {
      "maxDuration": 10,
      "supportsCancellation": true
    },
    "api/account.js": {
      "maxDuration": 10,
      "supportsCancellation": true
    },
    "api/health.js": {
      "maxDuration": 5,
      "supportsCancellation": true
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'sha256-ur5GpVieQQM9Fi9AlfUbHMOK5sQxr/hd2W7EHs8CJtA='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'; frame-src https://www.openstreetmap.org; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests" }
      ]
    }
  ]
}
